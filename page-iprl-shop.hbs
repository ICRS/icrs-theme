<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <style>
        @font-face { font-family: 'Tw Cen MT'; src: url('{{asset "fonts/iprl/TwCenMT.ttf"}}') format('truetype'); font-weight: 400 900; font-display: swap; }
        @font-face { font-family: 'Tw Cen MT Cond ExtraBold'; src: url('{{asset "fonts/iprl/TwCenMTStdExtraBoldCond.otf"}}') format('opentype'); font-weight: 800; font-display: swap; }
        @font-face { font-family: 'IntoDotMatrix'; src: url('{{asset "fonts/iprl/IntoDotMatrix.ttf"}}') format('truetype'); font-weight: 400; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: normal; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Italic-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: italic; font-display: swap; }
    </style>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{ghost_head}}
</head>
<body class="page-iprl {{body_class}}">

{{!--
  IPRL Shop — static lookbook page (Ghost has no native commerce). Per the
  design handoff, this links out to Imperial College Union's own store via
  @custom.icu_shop_url rather than hosting checkout here.

  Products are real Ghost Posts, one per product, filtered into their
  section by an internal tag and read like this:

    feature_image → product photo
    title         → product name and price together, e.g. "IPRL Zip Hoodie | £38"
                    (main.js splits on " | " client-side into name + price —
                    no title just shows as-is, with no price badge)
    custom_excerpt → description (falls back to autogenerated excerpt)
    tag           → which section it's in:
                      #iprl-shop-apparel
                      #iprl-shop-promotional
                      #iprl-shop-other
--}}

{{> iprl-header activeShop=true showEyebrow=true}}

<main class="site-content">
    <section class="iprl-shop-hero">
        <div class="iprl-shop-hero-inner">
            <div class="iprl-eyebrow">Shop</div>
            <h1 class="iprl-heading iprl-heading-light iprl-shop-title">Represent IPRL</h1>
            <p class="iprl-shop-lede">Help represent IPRL out in the world with our merch selection, all made by our free-range human designers</p>
            <div class="iprl-shop-hero-actions">
                <a href="#apparel">Apparel</a>
                <a href="#promotional">Promotional</a>
                <a href="#other">Other</a>
            </div>
            {{#if @custom.icu_shop_url}}
            <a href="{{@custom.icu_shop_url}}" class="iprl-btn iprl-btn-solid iprl-shop-cta" target="_blank" rel="noopener">Buy on the Union Store</a>
            {{/if}}
        </div>
    </section>

    {{#get "posts" filter="tag:hash-iprl-shop-apparel" limit="20" include="tags" as |apparel|}}
    {{#if apparel}}
    <section id="apparel" class="iprl-shop-section">
        <div class="iprl-shop-section-head">
            <h2 class="iprl-heading">Apparel</h2>
            <div class="iprl-shop-season">2026/27 season</div>
        </div>
        <div class="iprl-shop-grid">
            {{#foreach apparel}}
            <div class="iprl-shop-product">
                <div class="iprl-shop-product-media">
                    {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">{{/if}}
                </div>
                <div class="iprl-shop-product-row"><h3 class="iprl-shop-product-title">{{title}}</h3></div>
                <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="16"}}{{/if}}</p>
            </div>
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:hash-iprl-shop-promotional" limit="20" include="tags" as |promotional|}}
    {{#if promotional}}
    <section id="promotional" class="iprl-shop-section">
        <div class="iprl-shop-section-head">
            <h2 class="iprl-heading">Promotional</h2>
        </div>
        <div class="iprl-shop-grid">
            {{#foreach promotional}}
            <div class="iprl-shop-product">
                <div class="iprl-shop-product-media iprl-shop-product-media-rounded">
                    {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">{{/if}}
                </div>
                <div class="iprl-shop-product-row"><h3 class="iprl-shop-product-title">{{title}}</h3></div>
                <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="16"}}{{/if}}</p>
            </div>
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:hash-iprl-shop-other" limit="20" include="tags" as |other|}}
    {{#if other}}
    <section id="other" class="iprl-shop-section iprl-shop-section-last">
        <div class="iprl-shop-section-head">
            <h2 class="iprl-heading">Other</h2>
        </div>
        <div class="iprl-shop-grid">
            {{#foreach other}}
            <div class="iprl-shop-product">
                <div class="iprl-shop-product-media iprl-shop-product-media-rounded">
                    {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">{{/if}}
                </div>
                <div class="iprl-shop-product-row"><h3 class="iprl-shop-product-title">{{title}}</h3></div>
                <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="16"}}{{/if}}</p>
            </div>
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}
</main>

{{> iprl-footer}}

<script src="{{asset "js/main.js"}}"></script>
{{ghost_foot}}
</body>
</html>
