<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <style>
        @font-face { font-family: 'Tw Cen MT'; src: url('{{asset "fonts/iprl/TwCenMT.ttf"}}') format('truetype'); font-weight: 400 900; font-display: swap; }
        @font-face { font-family: 'Tw Cen MT Cond ExtraBold'; src: url('{{asset "fonts/iprl/TwCenMTStdExtraBoldCond.otf"}}') format('opentype'); font-weight: 800; font-display: swap; }
        @font-face { font-family: 'IntoDotMatrix'; src: url('{{asset "fonts/iprl/IntoDotMatrix.ttf"}}') format('truetype'); font-weight: 400; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: normal; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Italic-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: italic; font-display: swap; }
    </style>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{ghost_head}}
</head>
<body class="page-iprl {{body_class}}">

{{!--
  IPRL Front Page — standalone branded sub-site (own header/footer/fonts),
  same pattern as page-lobstar.hbs. Content is static per the design handoff;
  News, Sponsors, and Gallery are wired to real Ghost content:

    News       → tag "iprl"             (feature_image, primary_tag, title, custom_excerpt, primary_author)
    Sponsors   → tag "#iprl-sponsor"     (feature_image = logo, links to canonical_url if set)
    Gallery    → this Page's own body   (add a native Ghost Gallery card in Ghost Admin — Pages > IPRL)

  "Join the Lab" CTAs use the @custom.iprl_join_url setting (Settings > Design & Branding > Site-wide).
--}}

{{> iprl-header showEyebrow=true}}

<main class="site-content">
    <section id="top" class="iprl-hero">
        <div class="iprl-hero-media">
            <img src="{{asset "images/iprl/whole-team-photo.jpg"}}" alt="Whole IPRL team with the rover at ERC 2025" loading="eager">
        </div>
        <div class="iprl-hero-motif">{{> iprl-mark}}</div>
        <div class="iprl-hero-content">
            <h1 class="iprl-hero-title">Imperial<br>Planetary<br>Robotics Lab</h1>
            <p class="iprl-hero-body">We design and build rovers to represent Imperial at the European Rover Challenge. We also conduct cutting edge planetary robotics research through our research branch</p>
            <div class="iprl-hero-actions">
                <a href="{{#if @custom.iprl_join_url}}{{@custom.iprl_join_url}}{{else}}#join{{/if}}" class="iprl-btn iprl-btn-solid">Join the Lab</a>
                <a href="#info" class="iprl-btn iprl-btn-outline">Meet the Branches</a>
            </div>
        </div>
    </section>

    {{#get "posts" filter="tag:iprl" limit="3" include="tags,authors" as |posts|}}
    <section id="news" class="iprl-news">
        <div class="iprl-news-head">
            <div>
                <div class="iprl-eyebrow">Latest from the lab</div>
                <h2 class="iprl-heading">News</h2>
            </div>
        </div>
        {{#if posts}}
        <div class="iprl-news-grid">
            {{#foreach posts}}
            <article class="iprl-news-card">
                {{#if feature_image}}
                <div class="iprl-news-media"><img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy"></div>
                {{/if}}
                {{#if primary_tag}}<div class="iprl-news-tag">{{primary_tag.name}}</div>{{/if}}
                <h3 class="iprl-news-title"><a href="{{url}}">{{title}}</a></h3>
                <p class="iprl-news-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="24"}}{{/if}}</p>
                <div class="iprl-news-byline">
                    {{#foreach authors}}
                    {{#if @first}}
                    <span class="iprl-avatar" data-iprl-initials="{{name}}"></span>
                    <span class="iprl-news-meta">{{name}} &middot; {{date format="D MMMM YYYY"}}</span>
                    {{/if}}
                    {{/foreach}}
                </div>
            </article>
            {{/foreach}}
        </div>
        {{/if}}
    </section>
    {{/get}}

    {{#post}}
    <section id="gallery" class="iprl-gallery">
        <div class="iprl-gallery-head">
            <div class="iprl-eyebrow">From the lab</div>
            <h2 class="iprl-heading">Gallery</h2>
        </div>
        <div class="iprl-gallery-carousel">
            <button type="button" class="iprl-gallery-arrow iprl-gallery-arrow-prev" aria-label="Previous photos">&larr;</button>
            <div class="iprl-gallery-body">
                {{content}}
            </div>
            <button type="button" class="iprl-gallery-arrow iprl-gallery-arrow-next" aria-label="Next photos">&rarr;</button>
        </div>
    </section>
    {{/post}}

    <section id="info" class="iprl-info">
        <div class="iprl-info-intro">
            <div>
                <div class="iprl-eyebrow">What we build</div>
                <h2 class="iprl-heading">Two goals<br>One lab.</h2>
            </div>
            <p class="iprl-info-lede">IPRL’s mission is to create and maintain a community empowering the best space engineers and scientists at Imperial</p>
        </div>

        <div class="iprl-branch-grid">
            <article class="iprl-branch">
                <div class="iprl-branch-media"><img src="{{asset "images/iprl/rover-drone.jpg"}}" alt="Rover branch team at the European Rover Challenge" loading="lazy"></div>
                <div class="iprl-branch-body">
                    <div class="iprl-branch-label">{{> iprl-mark}}<span>Branch 01</span></div>
                    <h3 class="iprl-branch-title">Rover</h3>
                    <p>Every year, we build a new rover from scratch for the European Rover Challenge. We're the only UK team to have qualified in the last six years.</p>
                    <div class="iprl-branch-footnote">Harbinger '23 &rarr; BOBER '24 &rarr; BOBCat '25</div>
                </div>
            </article>
            <article class="iprl-branch">
                <div class="iprl-branch-media iprl-branch-media-dark"><img src="{{asset "images/iprl/science-2.jpg"}}" alt="Science and research branch concept render" loading="lazy"></div>
                <div class="iprl-branch-body">
                    <div class="iprl-branch-label">{{> iprl-mark}}<span>Branch 02</span></div>
                    <h3 class="iprl-branch-title">Science &amp; Research</h3>
                    <p>Planteary robotics and science research led by students. Our members have presented their work at international research events like Space Resources Week</p>
                    <div class="iprl-branch-footnote">Research Initiative</div>
                </div>
            </article>
        </div>
    </section>

    <div class="iprl-divider">{{> iprl-mark}}</div>

    <section id="supporters" class="iprl-supporters">
        <div class="iprl-supporters-motif">{{> iprl-motif}}</div>
        <div class="iprl-supporters-inner">
            <div class="iprl-supporters-head">
                <div>
                    <div class="iprl-eyebrow">Our supporters</div>
                    <h2 class="iprl-heading iprl-heading-light">Built with our sponsors</h2>
                </div>
                <p class="iprl-supporters-lede">IRPL is entirely funded by the Imperial College Robotics Society and our generous sponsors. Without them, there would be no IPRL. Thank you for backing us!</p>
            </div>
            <div class="iprl-sponsor-grid">
                {{#get "posts" filter="tag:hash-iprl-sponsor" limit="100" include="tags" as |sponsors|}}
                    {{#if sponsors}}
                        {{#foreach sponsors}}
                            {{#if canonical_url}}
                            <a class="iprl-sponsor-tile" href="{{canonical_url}}" target="_blank" rel="noopener sponsored">
                                <div class="iprl-sponsor-tile-media">
                                    {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">{{else}}<span class="iprl-sponsor-tile-fallback">{{title}}</span>{{/if}}
                                </div>
                                <span class="iprl-sponsor-name">{{title}}</span>
                            </a>
                            {{else}}
                            <div class="iprl-sponsor-tile">
                                <div class="iprl-sponsor-tile-media">
                                    {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">{{else}}<span class="iprl-sponsor-tile-fallback">{{title}}</span>{{/if}}
                                </div>
                                <span class="iprl-sponsor-name">{{title}}</span>
                            </div>
                            {{/if}}
                        {{/foreach}}
                    {{else}}
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                        <div class="iprl-sponsor-tile iprl-sponsor-tile-empty"></div>
                    {{/if}}
                {{/get}}
            </div>
        </div>
    </section>
</main>

{{> iprl-footer}}

<script src="{{asset "js/main.js"}}"></script>
{{ghost_foot}}
</body>
</html>
