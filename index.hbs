</section>


{{!-- ==========================================
  SECTION 2: Latest Newsletter
  Tag posts with internal tag #newsletter in Ghost Admin.
  Shows the most recent newsletter as a slim clickable bar.
  ========================================== --}}

{{#get "posts" filter="tag:hash-newsletter" limit="1" include="tags" as |newsletters|}}
    {{#if newsletters}}
        {{#foreach newsletters}}
        <a href="{{url}}" class="newsletter-banner">
            <span class="newsletter-label">Newsletter</span>
            <span class="newsletter-title">{{title}}</span>
            <span class="newsletter-arrow">&rarr;</span>
        </a>
        {{/foreach}}
    {{/if}}
{{/get}}


{{!-- ==========================================
  SECTION 3: Projects in Detail
  Tag posts/pages with internal tag #project-detail in Ghost Admin.
  Each post becomes a showcase card: feature_image, title, excerpt.
  The post URL links to the full project page.
  ========================================== --}}

{{#get "posts" filter="tag:hash-project-detail" limit="3" include="tags" as |projects|}}
    {{#if projects}}
    <section class="projects-detail-container">
        <div class="section-label">[PROJECTS]</div>
        <div class="projects-detail-grid">
            {{#foreach projects}}
            <a href="{{url}}" class="project-detail-card">
                <div class="project-detail-image">
                    {{#if feature_image}}
                        <img
                            srcset="{{img_url feature_image size="s"}} 300w,
                                    {{img_url feature_image size="m"}} 600w,
                                    {{img_url feature_image size="l"}} 1000w"
                            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
                            src="{{img_url feature_image size="m"}}"
                            alt="{{title}}"
                            loading="lazy"
                        >
                    {{else}}
                        <div class="project-detail-placeholder"></div>
                    {{/if}}
                </div>
                <div class="project-detail-body">
                    <h3 class="project-detail-title">{{title}}</h3>
                    {{#if excerpt}}
                    <p class="project-detail-excerpt">{{excerpt words="25"}}</p>
                    {{/if}}
                </div>
            </a>
            {{/foreach}}
        </div>
    </section>
    {{/if}}
{{/get}}


{{!-- ==========================================
  SECTION 4: Posts Bank — Horizontal Scroll
  Uses existing #icrs-post tag. Shows a side-scrolling row
  of recent posts (news, events, project updates).
  ========================================== --}}

<section class="posts-scroll-container">
    <div class="section-label">[POSTS]</div>
    <div class="posts-scroll-track">
        {{#get "posts" filter="tag:hash-icrs-post" limit="20" include="tags,authors" as |icrs_posts|}}
            {{#foreach icrs_posts}}
                {{> post-card}}
            {{/foreach}}
        {{/get}}
    </div>
</section>


{{!-- ==========================================
  SECTION 5: Gallery — Slow Scroll Marquee
  Tag posts with internal tag #gallery in Ghost Admin.
  Each post's feature_image becomes a gallery photo.
  Falls back to placeholder blocks if no gallery posts exist.
  ========================================== --}}

<section class="gallery-marquee-container floating-block">
    <div class="section-label">[GALLERY]</div>
    <div class="gallery-marquee-wrapper">
        <div class="gallery-marquee">
            {{#get "posts" filter="tag:hash-gallery" limit="20" include="tags" as |gallery_posts|}}
                {{#if gallery_posts}}
                    {{!-- First pass — real images --}}
                    {{#foreach gallery_posts}}
                        <div class="marquee-item">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                            {{else}}
                                <div class="marquee-placeholder"></div>
                            {{/if}}
                        </div>
                    {{/foreach}}
                    {{!-- Duplicate for seamless loop --}}
                    {{#foreach gallery_posts}}
                        <div class="marquee-item">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                            {{else}}
                                <div class="marquee-placeholder"></div>
                            {{/if}}
                        </div>
                    {{/foreach}}
                {{else}}
                    {{!-- Placeholders when no gallery posts exist yet --}}
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                    <div class="marquee-item placeholder-block"></div>
                {{/if}}
            {{/get}}
        </div>
    </div>
</section>


{{!-- ==========================================
  SECTION 6: Sponsors (if any exist)
  ========================================== --}}

{{#get "posts" filter="tag:hash-sponsor" limit="all" include="tags" as |sponsors|}}
    {{#if sponsors}}
    <section class="sponsors-container floating-block bordered-block">
        <div class="section-label">[SPONSORS]</div>
        <div class="sponsors-grid">
            {{#foreach sponsors}}
                {{#if canonical_url}}
                    <a href="{{canonical_url}}"
                       class="sponsor-item"
                       title="{{title}}"
                       target="_blank"
                       rel="noopener sponsored">
                        {{#if feature_image}}
                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                        {{else}}
                            <span class="sponsor-name">{{title}}</span>
                        {{/if}}
                    </a>
                {{else}}
                    <div class="sponsor-item" title="{{title}}">
                        {{#if feature_image}}
                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                        {{else}}
                            <span class="sponsor-name">{{title}}</span>
                        {{/if}}
                    </div>
                {{/if}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
{{/get}}
