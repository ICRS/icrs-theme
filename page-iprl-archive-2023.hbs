<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <style>
        @font-face { font-family: 'Tw Cen MT'; src: url('{{asset "fonts/iprl/TwCenMT.ttf"}}') format('truetype'); font-weight: 400 900; font-display: swap; }
        @font-face { font-family: 'Tw Cen MT Cond ExtraBold'; src: url('{{asset "fonts/iprl/TwCenMTStdExtraBoldCond.otf"}}') format('opentype'); font-weight: 800; font-display: swap; }
        @font-face { font-family: 'IntoDotMatrix'; src: url('{{asset "fonts/iprl/IntoDotMatrix.ttf"}}') format('truetype'); font-weight: 400; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: normal; font-display: swap; }
        @font-face { font-family: 'IPRL Inter'; src: url('{{asset "fonts/iprl/Inter-Italic-Variable.ttf"}}') format('truetype'); font-weight: 100 900; font-style: italic; font-display: swap; }
    </style>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{ghost_head}}
</head>
<body class="page-iprl {{body_class}}">

{{!--
  IPRL Mission Archive — 2023 (Harbinger). See page-iprl-archive-2025.hbs for
  field notes — specs strip, Team, Achievements, and Gallery are all
  authored in this Page's body in Ghost Admin, not hardcoded here.
--}}

{{> iprl-header activeArchive=true showEyebrow=true}}

<main class="site-content">
    {{#post}}
    <section class="iprl-archive-hero">
        <div class="iprl-archive-hero-inner">
            <div class="iprl-eyebrow">Mission Archive</div>
            <h1 class="iprl-heading iprl-heading-light iprl-archive-hero-title">Every rover.<br>Every season.</h1>
            <p class="iprl-archive-hero-lede">A season-by-season record of IPRL's rovers, the teams who built them, and what they achieved at the European Rover Challenge.</p>
        </div>
    </section>

    {{> iprl-archive-tabs active2023=true}}

    <section class="iprl-archive-panel">
        <div class="iprl-archive-splash">
            {{#if feature_image}}
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
            {{else}}
            <div class="iprl-archive-splash-placeholder"></div>
            {{/if}}
            <div class="iprl-archive-splash-scrim"></div>
            <div class="iprl-archive-splash-caption">
                <div class="iprl-eyebrow">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}European Rover Challenge 2023{{/if}}</div>
                <h2 class="iprl-archive-rover-name">{{#if title}}{{title}}{{else}}Harbinger{{/if}}</h2>
            </div>
        </div>

        <article class="iprl-archive-body">
            {{content}}
        </article>
    </section>
    {{/post}}
</main>

{{> iprl-footer}}

<script src="{{asset "js/main.js"}}"></script>
{{ghost_foot}}
</body>
</html>
